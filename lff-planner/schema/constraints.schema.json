{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "amyAbsences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "to": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      }
    },
    "amyDayTargets": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "min": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "max": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "preferredStart": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "min",
          "max"
        ],
        "additionalProperties": false
      }
    },
    "weights": {
      "type": "object",
      "properties": {
        "priority": {
          "type": "number"
        },
        "tristan": {
          "type": "number"
        },
        "amy": {
          "type": "number"
        },
        "onlyMaybe": {
          "type": "number"
        },
        "maybeMultiplier": {
          "type": "number"
        },
        "amyBelowTargetPenalty": {
          "type": "number"
        },
        "amyAboveTargetPenalty": {
          "type": "number"
        },
        "amyWindowPenalty": {
          "type": "number"
        }
      },
      "required": [
        "priority",
        "tristan",
        "amy",
        "onlyMaybe",
        "maybeMultiplier",
        "amyBelowTargetPenalty",
        "amyAboveTargetPenalty",
        "amyWindowPenalty"
      ],
      "additionalProperties": false
    },
    "paddingMinutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "solver": {
      "type": "object",
      "properties": {
        "timeBudgetMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "timeBudgetMs"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "amyAbsences",
    "amyDayTargets",
    "weights",
    "paddingMinutes",
    "solver"
  ],
  "additionalProperties": false
}
